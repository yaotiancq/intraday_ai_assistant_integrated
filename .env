# Default production behavior: regular trading hours only.
# Keep false for real use. Set true only for night/off-hour testing.
# extened time = premarket + regular hours + after hours
# session = RTH (regular trading hours) or 
#           ALL (premarket + regular hours + after hours) or 
#           PREG (premarket only) or 
#           AFT (after hours only) or
#           AUTO (auto-detect based on current time)
MONITOR_TEST_MODE=true
MONITOR_EXTENDED_TIME=true
MONITOR_FUTU_SESSION=ALL

# =========================
# Local admin API used by Discord Bot and premarket assistant
# =========================
