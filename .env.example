# Deterministic fixed-universe market analysis
MARKET_CONFIG_PATH=config/market_strategy.json
MARKET_OUTPUT_DIR=output/runs
DATA_DIR=data

# Futu / Moomoo OpenD
FUTU_HOST=127.0.0.1
FUTU_PORT=11111
FUTU_MARKET_PREFIX=US
FUTU_CONNECT_TIMEOUT=15
FUTU_EXTENDED_TIME=true

# Use deterministic synthetic observations for local development.
# Production research should set this to false and connect OpenD.
DEMO_MODE=true

# Optional deterministic RSS sources. Every parsed ticker is intersected with
# the configured 30-stock allowlist; news can never add universe members.
NEWS_RSS_URLS=https://www.investing.com/rss/news_25.rss

# Optional report notifications. A stage snapshot is committed before delivery.
DISCORD_PREMARKET_WEBHOOK_URL=
DISCORD_OPEN_CONFIRMATION_WEBHOOK_URL=
DISCORD_WARNINGS_WEBHOOK_URL=

# Optional bridge to the separate realtime monitor. Disabled by default.
MONITOR_UPDATE_ENABLED=false
MONITOR_ADMIN_URL=http://127.0.0.1:8765
WATCHLIST_ADMIN_TOKEN=
MONITOR_UPDATE_MODE=set
MONITOR_UPDATE_TIERS=CONFIRMED,WATCH
MONITOR_UPDATE_MAX_SYMBOLS=8

# Manual testing switches; keep false for scheduled production runs.
PREMARKET_FORCE_RUN=false
ALLOW_NON_TRADING_DAY_TEST=false

# Separate realtime-monitor service (not part of the staged strategy engine).
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_EVENTS=SIGNAL
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
ALLOWED_DISCORD_USER_IDS=
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8765
ADMIN_API_URL=http://127.0.0.1:8765
MONITOR_ALLOW_EMPTY_ADMIN_TOKEN=false
MONITOR_TEST_MODE=false
MONITOR_EXTENDED_TIME=false
MONITOR_FUTU_SESSION=RTH
MONITOR_BAR_PERIOD=3m

# Independent legacy research utilities. They are not started by the default
# market-scheduler deployment and are not part of the fixed-universe pipeline.
FMP_API_KEY=
ALPHAVANTAGE_API_KEY=
EARNINGS_UNIVERSE_MODE=watchlist_only
EARNINGS_WATCHLIST_SYMBOLS=NVDA,AMD,AAPL,MSFT,AMZN,META,GOOGL,TSLA
EARNINGS_MAX_DEEP_ANALYSIS_CANDIDATES=25
EARNINGS_OUTPUT_DIR=data/earnings
EARNINGS_DRY_RUN=true
DISCORD_EARNINGS_WEBHOOK_URL=
DISCORD_EXDIVIDEND_WEBHOOK_URL=
EXDIVIDEND_DRY_RUN=true
EXDIVIDEND_MAX_CANDIDATES=30
