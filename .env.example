# =========================
# OpenAI
# =========================
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-5-mini

# =========================
# Futu / Moomoo OpenD on Oracle host
# =========================
FUTU_HOST=127.0.0.1
FUTU_PORT=11111
FUTU_MARKET_PREFIX=US
FUTU_CONNECT_TIMEOUT=15
FUTU_EXTENDED_TIME=false
DEMO_MODE=false

# =========================
# Discord webhooks
# =========================
DISCORD_PREMARKET_WEBHOOK_URL=replace_with_premarket_webhook
DISCORD_OPEN_CONFIRMATION_WEBHOOK_URL=
DISCORD_INTRADAY_WEBHOOK_URL=
DISCORD_AFTER_CLOSE_WEBHOOK_URL=
DISCORD_WARNINGS_WEBHOOK_URL=

# Signal monitor webhook output. This can be the same or a separate signal channel.
DISCORD_WEBHOOK_URL=replace_with_signal_webhook
DISCORD_WEBHOOK_EVENTS=SIGNAL

# =========================
# Discord Slash Command Bot
# =========================
DISCORD_BOT_TOKEN=replace_with_discord_bot_token
DISCORD_GUILD_ID=replace_with_your_discord_server_id
ALLOWED_DISCORD_USER_IDS=replace_with_your_discord_user_id

# =========================
# Data / Report
# =========================
DATA_DIR=data
TIMEZONE=America/Los_Angeles
MAX_A_TIER=5
MAX_B_TIER=8

CORE_SYMBOLS=SPY,QQQ,IWM,DIA,NVDA,AMD,AVGO,QCOM,INTC,ARM,MU,TSM,ASML,MSFT,AAPL,AMZN,GOOGL,META,TSLA,CRM,ORCL,NOW,PLTR,SNOW,XOM,CVX,COP,SLB,JNJ,PEP,KO,COST,WMT
INDEX_SYMBOLS=SPY,QQQ,IWM,DIA
SECTOR_ETFS=XLK,SMH,SOXX,XLC,XLY,XLF,XLE,XLV,XLP,XLU,XLI,XRT
# General feeds are listed here. Per-symbol Yahoo Finance RSS feeds are generated from NEWS_QUERY_SYMBOLS below.
NEWS_RSS_URLS=https://www.investing.com/rss/news_25.rss
NEWS_QUERY_SYMBOLS=NVDA,AMD,AVGO,QCOM,INTC,ARM,MU,TSM,ASML,MSFT,AAPL,AMZN,GOOGL,META,TSLA,CRM,ORCL,NOW,PLTR,SNOW,XOM,CVX,COP,SLB,JNJ,PEP,KO,COST,WMT

# =========================
# Realtime monitor initial watchlist
# =========================
WATCH_SYMBOLS=US.SPY,US.QQQ,US.NVDA,US.TSLA,US.AMD
MAX_SYMBOLS=20

# Default production behavior: regular trading hours only.
# Keep false for real use. Set true only for night/off-hour testing.
MONITOR_TEST_MODE=false
MONITOR_EXTENDED_TIME=false
MONITOR_FUTU_SESSION=RTH

# =========================
# Local admin API used by Discord Bot and premarket assistant
# =========================
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8765
ADMIN_API_URL=http://127.0.0.1:8765
MONITOR_ADMIN_URL=http://127.0.0.1:8765
WATCHLIST_ADMIN_TOKEN=replace_with_a_long_random_secret

# Premarket assistant -> monitor watchlist bridge
MONITOR_UPDATE_ENABLED=true
MONITOR_UPDATE_MODE=add
MONITOR_UPDATE_TIERS=A,B
MONITOR_UPDATE_MAX_SYMBOLS=12

# =========================
# Daily premarket scheduler
# =========================
PREMARKET_RUN_TIME=05:45
PREMARKET_SEND_DISCORD=true
PREMARKET_SEND_TO_MONITOR=true
PREMARKET_DRY_RUN=false
PREMARKET_SCHEDULER_POLL_SECONDS=30

# Test switches. Keep false in production.
PREMARKET_FORCE_RUN=false
ALLOW_NON_TRADING_DAY_TEST=false
PREMARKET_TEST_RUN_ON_START=false
